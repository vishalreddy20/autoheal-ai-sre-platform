# Supabase endpoint
SUPABASE_DB_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres
SUPABASE_DB_URL_REPLICA=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# CORS
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Docker socket path
DOCKER_SOCKET=/var/run/docker.sock

# JWT Authentication (REQUIRED — generate a strong secret)
AUTH_JWT_SECRET=your-strong-jwt-secret-here

# Alertmanager webhook HMAC secret (leave empty to disable signature validation)
ALERTMANAGER_WEBHOOK_SECRET=

# Healing dry-run mode (true = simulate without executing)
HEALING_DRY_RUN=false
